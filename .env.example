# ─── Espelhos de outros produtos (painel-mãe lê, somente leitura) ─
# ⚠ HOJE ESTAS VARIÁVEIS NÃO ESTÃO DEFINIDAS EM LUGAR NENHUM — nem local,
#   nem no build do Cloudflare Pages. Conferido em 08/09/2026 pelo bundle
#   publicado: as anon keys EMBUTIDAS em src/lib/espelhoMotores.ts como
#   fallback (`import.meta.env.X || 'eyJ...'`) são o que está em uso.
#   Chave em código é chave publicada — é dívida da auditoria (Spec §9).
#   A ordem do conserto importa: DEFINIR AQUI E NO PAINEL DO PAGES PRIMEIRO,
#   e só então remover o fallback do código. Remover antes cega os espelhos
#   de Limelight e Pulso em produção, sem erro de tela.
VITE_LIMELIGHT_SUPABASE_URL="https://gfdpvasbrxwulvpvyfvr.supabase.co"
VITE_LIMELIGHT_SUPABASE_ANON_KEY="anon-key-do-limelight"
VITE_PULSO_SUPABASE_URL="https://nlcisbfdiokmipyihtuz.supabase.co"
VITE_PULSO_SUPABASE_ANON_KEY="anon-key-do-pulso"   # só v_espelho_pulso_dias (engajamento);
                                                   # custo/receita agora vêm pela edge function
                                                   # espelho-pulso, nunca por anon key.
# Blogs: a URL é constante literal no código, sem variável. Mesma dívida.

# ─── Links externos dos Ecossistemas (sidebar — ADR-0029) ────────
# ⚠ AS TRÊS ABAIXO NÃO SÃO LIDAS POR NADA. Conferido em 08/09/2026:
#   `grep -rn "ATLAS_URL\|OSI_URL\|CLEARIX_HUB_URL" src/` → zero ocorrências.
#   O comentário antigo dizia "se ausentes, usa os defaults do Sidebar" — na
#   prática usa os defaults SEMPRE, definidas ou não. Ou o Sidebar passa a
#   lê-las, ou saem daqui; enquanto ficarem, documentam um controle que não existe.
VITE_ATLAS_URL="https://digiaiatlas.netlify.app"
VITE_OSI_URL="https://oticasemimproviso.netlify.app"
VITE_CLEARIX_HUB_URL=""   # ainda não deployado — vazio mostra "em construção"

# ─── Git (padrão da empresa — R-020) ─────────────────────────────
# Credential helper local lê GITHUB_USERNAME e GITHUB_TOKEN do .env.
# Gerar PAT: https://github.com/settings/tokens (escopo: repo)
GITHUB_USERNAME="sisdigiai"
GITHUB_TOKEN="ghp_SUBSTITUA_PELO_SEU_TOKEN"   # rotação: ____-__-__ (até +90d)

# ─── Supabase Management API PAT ─────────────────────────────────
